* {
    background:        #1e1e2e;
    foreground:        #cdd6f4;
    background-alt:    #313244;
    selected:          #89b4fa;
    active:            #f38ba8;
    urgent:            #f38ba8;
    text:              #cdd6f4;
    text-selected:     #1e1e2e;

    shade-shadow:      #ffffff10;
    shade-bg:          #ffffff20;
    shade-border:      #ffffff30;
}

window {
    fullscreen:         false;
    transparency:       "real";
    background-color:   @background-alt;
    border:             2px;
    border-color:       @selected;
}

/* Elements ----------------------------------------------------- */
element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @text;
}

element selected.normal {
    background-color:   @selected;
    text-color:         @text-selected;

    border:             1px solid;
    border-color:       @foreground;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    highlight:          inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
}

/* Listview ---------------------------------------------------- */
listview {
    border:             0px;
}

/* Scrollbar ---------------------------------------------------- */
scrollbar {
    margin:             0px 4px;
    handle-width:       8px;
    handle-color:       @foreground;
    background-color:   @shade-shadow;
    border-radius:      4px;
}

/* Messages ---------------------------------------------------- */
message {
    background-color:   @shade-bg;
    border-radius:      12px;
    padding:            24px;

    border:             1px solid;
    border-color:       transparent;
}

error-message {
    padding:            100px;
    border:             0px;
    border-radius:      0px;
    background-color:   @background-alt;
    text-color:         @text;
}

textbox {
    background-color:   transparent;
    text-color:         @text;
}

